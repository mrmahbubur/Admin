# DEFAULT_APP_PORT: Port the local/container Express + Vite server listens on.
# AI Studio sets PORT=8080 for its outer proxy and expects the app on 3000.
DEFAULT_APP_PORT="3000"

# GRAVATAR_API_KEY: Server-side Gravatar REST API v3 Bearer token (saved in Secrets).
GRAVATAR_API_KEY="MY_GRAVATAR_API_KEY"

# GRAVATAR_USERNAME: Primary Gravatar profile identifier for M R S data sync.
GRAVATAR_USERNAME="mrxshahin"

# UPSTREAM_SOURCE_URL: Portfolio ecosystem RSS & web hub endpoint.
UPSTREAM_SOURCE_URL="https://mrxshahin.ai.studio"

# DISABLE_HMR: Disable Vite HMR websocket & file watching during development edits.
DISABLE_HMR="true"

# APP_URL: The canonical URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
